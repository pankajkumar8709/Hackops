# ─────────────────────────────────────────────
# Database  (paste connection string from Supabase or Neon dashboard)
# Before filling these in, run in their SQL editor:
#   CREATE EXTENSION IF NOT EXISTS vector;
# ─────────────────────────────────────────────

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB?sslmode=require
DATABASE_SYNC_URL=postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DB?sslmode=require

# ─────────────────────────────────────────────
# LLM
# ─────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ─────────────────────────────────────────────
# Embeddings  (local sentence-transformers, no extra API cost)
# ─────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─────────────────────────────────────────────
# CORS  (React dev server)
# ─────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
